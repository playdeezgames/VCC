#+feature dynamic-literals
package asm6809

import "core:fmt"
import "core:strings"
import "core:testing"

// Assemble `body` at $1000 and return the generated bytes (errors fail the test).
assemble_body :: proc(t: ^testing.T, body: string) -> (bytes: []u8, ok: bool) {
	src := fmt.tprintf("\torg $1000\n%s\n", body)
	r := assemble_text("test.asm", src)
	defer destroy(&r)
	if len(r.errors) > 0 {
		testing.expectf(t, false, "assembling %q: %s", body, format_errors(&r, context.temp_allocator))
		return nil, false
	}
	n := r.hi - r.lo + 1 if r.hi >= r.lo else 0
	out := make([]u8, n, context.temp_allocator)
	copy(out, r.mem[r.lo:][:n])
	return out, true
}

expect_error :: proc(t: ^testing.T, body, needle: string) {
	src := fmt.tprintf("\torg $1000\n%s\n", body)
	r := assemble_text("test.asm", src)
	defer destroy(&r)
	testing.expectf(t, len(r.errors) > 0, "expected an error for %q", body)
	if len(r.errors) > 0 {
		msg := format_errors(&r, context.temp_allocator)
		testing.expectf(t, strings.contains(msg, needle), "error for %q was %q, wanted %q", body, msg, needle)
	}
}

Case :: struct {
	src:  string,
	want: []u8,
}

expect_cases :: proc(t: ^testing.T, cases: []Case) {
	for c in cases {
		got, ok := assemble_body(t, strings.concatenate({"\t", c.src}, context.temp_allocator))
		if !ok {continue}
		testing.expectf(t, slice_equal(got, c.want), "%q: got % 02X, want % 02X", c.src, got, c.want)
	}
}

slice_equal :: proc(a, b: []u8) -> bool {
	if len(a) != len(b) {return false}
	for x, i in a {
		if x != b[i] {return false}
	}
	return true
}

@(test)
inherent_encodings :: proc(t: ^testing.T) {
	expect_cases(t, []Case {
		{"nop", {0x12}}, {"sync", {0x13}}, {"daa", {0x19}}, {"sex", {0x1D}}, {"rts", {0x39}},
		{"abx", {0x3A}}, {"rti", {0x3B}}, {"mul", {0x3D}}, {"swi", {0x3F}},
		{"swi2", {0x10, 0x3F}}, {"swi3", {0x11, 0x3F}},
		{"nega", {0x40}}, {"coma", {0x43}}, {"lsra", {0x44}}, {"rora", {0x46}}, {"asra", {0x47}},
		{"asla", {0x48}}, {"lsla", {0x48}}, {"rola", {0x49}}, {"deca", {0x4A}}, {"inca", {0x4C}},
		{"tsta", {0x4D}}, {"clra", {0x4F}},
		{"negb", {0x50}}, {"comb", {0x53}}, {"lsrb", {0x54}}, {"rorb", {0x56}}, {"asrb", {0x57}},
		{"aslb", {0x58}}, {"lslb", {0x58}}, {"rolb", {0x59}}, {"decb", {0x5A}}, {"incb", {0x5C}},
		{"tstb", {0x5D}}, {"clrb", {0x5F}},
		{"NOP", {0x12}}, {"Rts", {0x39}}, // case does not matter
	})
}

@(test)
immediate_and_register_encodings :: proc(t: ^testing.T) {
	expect_cases(t, []Case {
		{"andcc #$EF", {0x1C, 0xEF}}, {"orcc #$50", {0x1A, 0x50}}, {"cwai #$EF", {0x3C, 0xEF}},
		{"tfr a,b", {0x1F, 0x89}}, {"tfr x,y", {0x1F, 0x12}}, {"exg d,x", {0x1E, 0x01}},
		{"tfr s,u", {0x1F, 0x43}}, {"tfr dp,a", {0x1F, 0xB8}}, {"tfr pc,x", {0x1F, 0x51}},
		{"tfr cc,a", {0x1F, 0xA8}}, {"TFR A,DP", {0x1F, 0x8B}},
		{"pshs a,b,x,pc", {0x34, 0x96}}, {"puls cc,a", {0x35, 0x03}}, {"pshs d", {0x34, 0x06}},
		{"pshs u,y", {0x34, 0x60}}, {"pshu a,s", {0x36, 0x42}}, {"pulu y,pc", {0x37, 0xA0}},
		{"pshs cc,a,b,dp,x,y,u,pc", {0x34, 0xFF}},
	})
}

@(test)
alu_encodings :: proc(t: ^testing.T) {
	expect_cases(t, []Case {
		{"lda #$12", {0x86, 0x12}}, {"ldb #$FF", {0xC6, 0xFF}}, {"ldb #-1", {0xC6, 0xFF}},
		{"suba #1", {0x80, 0x01}}, {"subb #1", {0xC0, 0x01}}, {"cmpa #1", {0x81, 0x01}},
		{"cmpb #1", {0xC1, 0x01}}, {"sbca #1", {0x82, 0x01}}, {"sbcb #1", {0xC2, 0x01}},
		{"anda #1", {0x84, 0x01}}, {"andb #1", {0xC4, 0x01}}, {"bita #1", {0x85, 0x01}},
		{"bitb #1", {0xC5, 0x01}}, {"eora #1", {0x88, 0x01}}, {"eorb #1", {0xC8, 0x01}},
		{"adca #1", {0x89, 0x01}}, {"adcb #1", {0xC9, 0x01}}, {"ora #1", {0x8A, 0x01}},
		{"orb #1", {0xCA, 0x01}}, {"adda #1", {0x8B, 0x01}}, {"addb #1", {0xCB, 0x01}},
		{"lda <$12", {0x96, 0x12}}, {"lda $12", {0xB6, 0x00, 0x12}}, {"lda >$12", {0xB6, 0x00, 0x12}},
		{"lda $1234", {0xB6, 0x12, 0x34}}, {"ldb $1234", {0xF6, 0x12, 0x34}},
		{"sta <$20", {0x97, 0x20}}, {"sta $1234", {0xB7, 0x12, 0x34}}, {"stb <$20", {0xD7, 0x20}},
		{"stb $1234", {0xF7, 0x12, 0x34}},
		{"ldd #$1234", {0xCC, 0x12, 0x34}}, {"ldd <$20", {0xDC, 0x20}}, {"std <$20", {0xDD, 0x20}},
		{"std $1234", {0xFD, 0x12, 0x34}}, {"ldx #$1234", {0x8E, 0x12, 0x34}},
		{"stx <$20", {0x9F, 0x20}}, {"ldu #0", {0xCE, 0x00, 0x00}}, {"stu <$20", {0xDF, 0x20}},
		{"ldy #1", {0x10, 0x8E, 0x00, 0x01}}, {"sty <$20", {0x10, 0x9F, 0x20}},
		{"sty $0020", {0x10, 0xBF, 0x00, 0x20}}, {"lds #$8000", {0x10, 0xCE, 0x80, 0x00}},
		{"sts <$20", {0x10, 0xDF, 0x20}}, {"subd #1", {0x83, 0x00, 0x01}},
		{"addd #1", {0xC3, 0x00, 0x01}}, {"addd ,x", {0xE3, 0x84}}, {"cmpx #1", {0x8C, 0x00, 0x01}},
		{"cmpd #1", {0x10, 0x83, 0x00, 0x01}}, {"cmpy ,x", {0x10, 0xAC, 0x84}},
		{"cmpu #1", {0x11, 0x83, 0x00, 0x01}}, {"cmps #1", {0x11, 0x8C, 0x00, 0x01}},
		{"cmps $1234", {0x11, 0xBC, 0x12, 0x34}},
		{"jsr $1234", {0xBD, 0x12, 0x34}}, {"jsr <$20", {0x9D, 0x20}}, {"jsr ,x", {0xAD, 0x84}},
		{"jmp $1234", {0x7E, 0x12, 0x34}}, {"jmp ,x", {0x6E, 0x84}}, {"jmp <$20", {0x0E, 0x20}},
		{"neg <$20", {0x00, 0x20}}, {"neg ,x", {0x60, 0x84}}, {"com $1234", {0x73, 0x12, 0x34}},
		{"lsr <$20", {0x04, 0x20}}, {"ror <$20", {0x06, 0x20}}, {"asr <$20", {0x07, 0x20}},
		{"asl <$20", {0x08, 0x20}}, {"lsl <$20", {0x08, 0x20}}, {"rol <$20", {0x09, 0x20}},
		{"dec <$20", {0x0A, 0x20}}, {"inc <$20", {0x0C, 0x20}}, {"tst $1234", {0x7D, 0x12, 0x34}},
		{"clr <$20", {0x0F, 0x20}}, {"clr $1234", {0x7F, 0x12, 0x34}},
	})
}

@(test)
indexed_encodings :: proc(t: ^testing.T) {
	expect_cases(t, []Case {
		{"lda ,x", {0xA6, 0x84}}, {"lda ,y", {0xA6, 0xA4}}, {"lda ,u", {0xA6, 0xC4}},
		{"lda ,s", {0xA6, 0xE4}}, {"lda 0,x", {0xA6, 0x84}},
		{"lda 5,x", {0xA6, 0x05}}, {"lda -16,x", {0xA6, 0x10}}, {"lda 15,x", {0xA6, 0x0F}},
		{"lda 5,s", {0xA6, 0x65}}, {"lda -1,y", {0xA6, 0x3F}},
		{"lda 16,x", {0xA6, 0x88, 0x10}}, {"lda -17,x", {0xA6, 0x88, 0xEF}},
		{"lda 127,y", {0xA6, 0xA8, 0x7F}}, {"lda -128,x", {0xA6, 0x88, 0x80}},
		{"lda 128,x", {0xA6, 0x89, 0x00, 0x80}}, {"lda $1234,x", {0xA6, 0x89, 0x12, 0x34}},
		{"lda <5,x", {0xA6, 0x88, 0x05}}, {"lda >5,x", {0xA6, 0x89, 0x00, 0x05}},
		{"lda a,x", {0xA6, 0x86}}, {"lda b,x", {0xA6, 0x85}}, {"lda d,x", {0xA6, 0x8B}},
		{"lda B,Y", {0xA6, 0xA5}},
		{"lda ,x+", {0xA6, 0x80}}, {"lda ,x++", {0xA6, 0x81}}, {"lda ,-x", {0xA6, 0x82}},
		{"lda ,--x", {0xA6, 0x83}}, {"lda ,u+", {0xA6, 0xC0}}, {"lda ,--s", {0xA6, 0xE3}},
		{"lda [,x]", {0xA6, 0x94}}, {"lda [5,x]", {0xA6, 0x98, 0x05}},
		{"lda [300,x]", {0xA6, 0x99, 0x01, 0x2C}}, {"lda [a,x]", {0xA6, 0x96}},
		{"lda [d,y]", {0xA6, 0xBB}}, {"lda [,x++]", {0xA6, 0x91}}, {"lda [,--y]", {0xA6, 0xB3}},
		{"lda [$1234]", {0xA6, 0x9F, 0x12, 0x34}}, {"jmp [$FFFE]", {0x6E, 0x9F, 0xFF, 0xFE}},
		{"leax 1,x", {0x30, 0x01}}, {"leay ,y", {0x31, 0xA4}}, {"leas 2,s", {0x32, 0x62}},
		{"leau -1,u", {0x33, 0x5F}}, {"leax d,x", {0x30, 0x8B}},
		{"sta 4,x", {0xA7, 0x04}}, {"std 2,u", {0xED, 0x42}}, {"stx ,y++", {0xAF, 0xA1}},
		{"sty ,x", {0x10, 0xAF, 0x84}}, {"lds ,x", {0x10, 0xEE, 0x84}},
	})
}

@(test)
branch_encodings :: proc(t: ^testing.T) {
	// "x *" branches to itself: the offset is -2 for short and -3/-4 for long forms.
	short := [?]struct {
		n: string,
		c: u8,
	}{{"bra", 0x20}, {"brn", 0x21}, {"bhi", 0x22}, {"bls", 0x23}, {"bcc", 0x24}, {"bhs", 0x24},
		{"bcs", 0x25}, {"blo", 0x25}, {"bne", 0x26}, {"beq", 0x27}, {"bvc", 0x28}, {"bvs", 0x29},
		{"bpl", 0x2A}, {"bmi", 0x2B}, {"bge", 0x2C}, {"blt", 0x2D}, {"bgt", 0x2E}, {"ble", 0x2F},
		{"bsr", 0x8D}}
	for s in short {
		got, ok := assemble_body(t, fmt.tprintf("\t%s *", s.n))
		if ok {testing.expectf(t, slice_equal(got, {s.c, 0xFE}), "%s: got % 02X", s.n, got)}
		if s.n == "bsr" {continue}
		got, ok = assemble_body(t, fmt.tprintf("\tl%s *", s.n))
		if ok {
			want := []u8{0x10, s.c, 0xFF, 0xFC}
			if s.n == "bra" {want = {0x16, 0xFF, 0xFD}}
			testing.expectf(t, slice_equal(got, want), "l%s: got % 02X", s.n, got)
		}
	}
	expect_cases(t, []Case{{"lbsr *", {0x17, 0xFF, 0xFD}}, {"bne *+2", {0x26, 0x00}}, {"bra *+129", {0x20, 0x7F}}, {"bra *-126", {0x20, 0x80}}})
}

@(test)
expressions :: proc(t: ^testing.T) {
	expect_cases(t, []Case {
		{"fcb 1+2*3", {7}}, {"fcb (1+2)*3", {9}}, {"fcb 10-3-2", {5}}, {"fcb $FF&$0F", {0x0F}},
		{"fcb $F0|$0F", {0xFF}}, {"fcb 5^1", {4}}, {"fcb 1<<4", {0x10}}, {"fcb $80>>3", {0x10}},
		{"fcb ~0&$FF", {0xFF}}, {"fcb -1", {0xFF}}, {"fcb !0", {1}}, {"fcb !5", {0}},
		{"fcb <$1234", {0x34}}, {"fcb >$1234", {0x12}}, {"fcb %1010", {10}}, {"fcb 0x10", {16}},
		{"fcb 10%3", {1}}, {"fcb 7/2", {3}}, {"fcb 5>3", {1}}, {"fcb 3>=4", {0}}, {"fcb 2==2", {1}},
		{"fcb 2!=2", {0}}, {"fcb 1||0", {1}}, {"fcb 1&&0", {0}}, {"fcb 1<2", {1}}, {"fcb 2<=1", {0}},
		{"fcb 'A", {65}}, {"fcb 'A','B'", {65, 66}}, {"fcb ' ", {32}}, {"fcb ','", {44}},
		{"fcb 1<<2+1", {8}}, // + binds tighter than <<
		{"fdb *", {0x10, 0x00}}, {"fdb $1234,5", {0x12, 0x34, 0x00, 0x05}}, {"fdb -2", {0xFF, 0xFE}},
		{"fcc \"AB\"", {0x41, 0x42}}, {"fcc /A B/", {0x41, 0x20, 0x42}}, {"fcn \"A\"", {0x41, 0}},
		{"fcb \"hi\",13,0", {0x68, 0x69, 13, 0}},
		{"zmb 3", {0, 0, 0}}, {"fcb 1 ; a comment", {1}},
	})
}

@(test)
labels_and_forward_references :: proc(t: ^testing.T) {
	body := `
start	lda #1
	bra later
	nop
later	rts
	fdb start,later,*
`
	got, ok := assemble_body(t, body)
	if ok {
		want := []u8{0x86, 0x01, 0x20, 0x01, 0x12, 0x39, 0x10, 0x00, 0x10, 0x05, 0x10, 0x0A}
		testing.expectf(t, slice_equal(got, want), "got % 02X", got)
	}

	// Forward references always use the long operand forms, and so does a
	// backward one when no direct page is set.
	got, ok = assemble_body(t, "\tlda fwd\n\tlda 1,x\n\tlda fwd,x\nfwd equ $20")
	if ok {
		want := []u8{0xB6, 0x00, 0x20, 0xA6, 0x01, 0xA6, 0x89, 0x00, 0x20}
		testing.expectf(t, slice_equal(got, want), "got % 02X", got)
	}

	// Chains of forward EQUs settle after a few passes.
	r := assemble_text("t.asm", "c equ d+1\nd equ e+1\ne equ 5\n")
	defer destroy(&r)
	v, found := symbol_value(&r, "c")
	testing.expect(t, found && v == 7)
	testing.expectf(t, len(r.errors) == 0, "%s", format_errors(&r, context.temp_allocator))
}

@(test)
direct_page :: proc(t: ^testing.T) {
	expect_cases(t, []Case {
		{"setdp $FF\n\tlda $FF22\n\tlda $FE22\n\tsta $FF20", {0x96, 0x22, 0xB6, 0xFE, 0x22, 0x97, 0x20}},
		{"setdp 0\n\tlda $22\n\tlda $1234", {0x96, 0x22, 0xB6, 0x12, 0x34}},
		{"setdp 0\n\tlda >$22", {0xB6, 0x00, 0x22}},
		{"setdp 0\n\tlda fwd\nfwd equ 5", {0xB6, 0x00, 0x05}}, // forward: not known to be direct
		{"setdp 0\nfwd equ 5\n\tlda fwd", {0x96, 0x05}},
	})
	expect_error(t, "\tsetdp $FF\n\tlda <$1234", "direct page")
}

@(test)
pc_relative :: proc(t: ^testing.T) {
	got, ok := assemble_body(t, "msg\tfcb 1\n\tlda msg,pcr\n\tleax msg,pcr")
	if ok {
		// lda at $1001: offset = $1000 - $1004 = -4; leax at $1004: $1000 - $1007 = -7
		want := []u8{0x01, 0xA6, 0x8C, 0xFC, 0x30, 0x8C, 0xF9}
		testing.expectf(t, slice_equal(got, want), "got % 02X", got)
	}
	got, ok = assemble_body(t, "\tlda msg,pcr\nmsg\tfcb 7")
	if ok {
		want := []u8{0xA6, 0x8D, 0x00, 0x00, 0x07} // forward reference: 16 bit offset
		testing.expectf(t, slice_equal(got, want), "got % 02X", got)
	}
	got, ok = assemble_body(t, "\tlda [msg,pcr]\nmsg\tfcb 7")
	if ok {testing.expectf(t, slice_equal(got, {0xA6, 0x9D, 0x00, 0x00, 0x07}), "got % 02X", got)}
	got, ok = assemble_body(t, "\tlda 5,pc")
	if ok {testing.expectf(t, slice_equal(got, {0xA6, 0x8C, 0x05}), "got % 02X", got)}
}

@(test)
local_labels :: proc(t: ^testing.T) {
	got, ok := assemble_body(t, "first\n.loop\tbra .loop\nsecond\n.loop\tbra .loop\n\tbra first.loop")
	if ok {testing.expectf(t, slice_equal(got, {0x20, 0xFE, 0x20, 0xFE, 0x20, 0xFA}), "got % 02X", got)}
}

@(test)
conditionals :: proc(t: ^testing.T) {
	body := `
FLAG	equ 1
	if FLAG
	fcb 1
	else
	fcb 2
	endif
	if FLAG==0
	fcb 3
	else
	fcb 4
	endif
	ifdef FLAG
	fcb 5
	endif
	ifndef NOPE
	fcb 6
	endif
	if 0
	if 1
	fcb 99
	endif
	bogus instruction here
	endif
`
	got, ok := assemble_body(t, body)
	if ok {testing.expectf(t, slice_equal(got, {1, 4, 5, 6}), "got % 02X", got)}
	expect_error(t, "\tif 1", "endif")
	expect_error(t, "\tendif", "without")
}

@(test)
data_directives :: proc(t: ^testing.T) {
	got, ok := assemble_body(t, "\tfcb 1\n\talign 4\n\tfcb 2\n\trmb 2\n\tfcb 3\n\tfcb 4\n\talign 4,$FF")
	if ok {testing.expectf(t, slice_equal(got, {1, 0, 0, 0, 2, 0, 0, 3, 4, 0xFF, 0xFF, 0xFF}), "got % 02X", got)}
	// org moves the output; the image holds both pieces.
	r := assemble_text("t.asm", "\torg $2000\n\tfcb 1\n\torg $2010\n\tfcb 2\n")
	defer destroy(&r)
	img := image(&r, 0x2000, 0x11, 0xAA)
	defer delete(img)
	testing.expect_value(t, img[0], 1)
	testing.expect_value(t, img[1], 0xAA)
	testing.expect_value(t, img[0x10], 2)
	testing.expect_value(t, r.lo, 0x2000)
	testing.expect_value(t, r.hi, 0x2010)
}

include_files: map[string]string

fake_read :: proc(path: string) -> (string, bool) {
	text, ok := include_files[path]
	if !ok {return "", false}
	return strings.clone(text), true
}

@(test)
include_directive :: proc(t: ^testing.T) {
	include_files = {
		"main.asm"       = "\torg $1000\n\tinclude \"defs.asm\"\n\tlda #VALUE\n\tinclude sub/more.asm\n\tfcb AFTER\n",
		"defs.asm"       = "VALUE\tequ 42\n",
		"sub/more.asm"   = "AFTER\tequ 7\n\tinclude \"deeper.asm\"\n",
		"sub/deeper.asm" = "\tnop\n",
	}
	defer delete(include_files)
	r := assemble_file("main.asm", {read_file = fake_read})
	defer destroy(&r)
	testing.expectf(t, len(r.errors) == 0, "%s", format_errors(&r, context.temp_allocator))
	testing.expect_value(t, r.mem[0x1000], 0x86)
	testing.expect_value(t, r.mem[0x1001], 42)
	testing.expect_value(t, r.mem[0x1002], 0x12)
	testing.expect_value(t, r.mem[0x1003], 7)

	delete(include_files)
	include_files = {
		"bad.asm" = "\tinclude \"missing.asm\"\n",
	}
	r2 := assemble_file("bad.asm", {read_file = fake_read})
	defer destroy(&r2)
	testing.expect(t, len(r2.errors) == 1)
}

@(test)
error_reporting :: proc(t: ^testing.T) {
	expect_error(t, "\tfrobnicate", "unknown")
	expect_error(t, "\tlda #256", "out of range")
	expect_error(t, "\tfcb 256", "out of range")
	expect_error(t, "\tfcb -129", "out of range")
	expect_error(t, "\tfdb 70000", "out of range")
	expect_error(t, "\tlda missing", "undefined symbol")
	expect_error(t, "x\tnop\nx\tnop", "duplicate")
	expect_error(t, "\tbra *+130", "out of range")
	expect_error(t, "\tbra *-127", "out of range")
	expect_error(t, "\tsta #1", "no immediate")
	expect_error(t, "\tleax 5", "indexed")
	expect_error(t, "\tlda 5,q", "index register")
	expect_error(t, "\tlda ,x+++", "bad")
	expect_error(t, "\tlda [,x+]", "indirect")
	expect_error(t, "\ttfr a,x", "mix")
	expect_error(t, "\ttfr a", "two registers")
	expect_error(t, "\tpshs s", "own stack")
	expect_error(t, "\tpshu u", "own stack")
	expect_error(t, "\tfcb 1/0", "division")
	expect_error(t, "\tfcb (1+2", "missing")
	expect_error(t, "\tfcb 12abc", "bad digit")
	expect_error(t, "\torg $10000", "outside")
	expect_error(t, "\tfcb 1\n\torg $1000\n\tfcb 2", "overlapping")
	expect_error(t, "\tfcc \"abc", "unterminated")
	expect_error(t, "\terror custom message", "custom message")
	expect_error(t, "\torg later\nlater equ $1000", "already defined")

	// Errors carry the file name and line number.
	r := assemble_text("prog.asm", "\tnop\n\tbogus\n")
	defer destroy(&r)
	testing.expect_value(t, len(r.errors), 1)
	if len(r.errors) == 1 {
		testing.expect_value(t, r.errors[0].file, "prog.asm")
		testing.expect_value(t, r.errors[0].line, 2)
	}
}

@(test)
listing_and_symbols :: proc(t: ^testing.T) {
	r := assemble_text("l.asm", "\torg $1000\nstart\tlda #$12 ; load\n\tfcb 1,2,3,4,5,6\n* comment\nend_\tequ $55\n")
	defer destroy(&r)
	testing.expectf(t, len(r.errors) == 0, "%s", format_errors(&r, context.temp_allocator))
	testing.expect(t, strings.contains(r.listing, "1000  86 12"), r.listing)
	testing.expect(t, strings.contains(r.listing, "1002  01 02 03 04"), r.listing)
	testing.expect(t, strings.contains(r.listing, "1006  05 06"), r.listing)
	syms := format_symbols(&r, context.temp_allocator)
	testing.expect(t, strings.contains(syms, "start"), syms)
	v, found := symbol_value(&r, "end_")
	testing.expect(t, found && v == 0x55)
}
